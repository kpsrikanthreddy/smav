# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Central SMAV Supabase Project Configuration (Item 1)
# URL of your central SMAV Supabase project (e.g. https://your-project-id.supabase.co)
SMAV_SUPABASE_URL="https://your-central-smav-project.supabase.co"

# Publishable anon key (safe for client & server auth; NEVER use service_role key)
SMAV_SUPABASE_ANON_KEY="your-central-smav-anon-publishable-key"

# Client-side Vite environment mirrors
VITE_SMAV_SUPABASE_URL="${SMAV_SUPABASE_URL}"
VITE_SMAV_SUPABASE_ANON_KEY="${SMAV_SUPABASE_ANON_KEY}"

# Supabase Edge Function Configuration
SMAV_EDGE_FUNCTION_URL="https://qykdwswatopylzvqhgog.supabase.co/functions/v1/smav-identity-admin"

# Backend Integration Keys (Server-to-Server only - NEVER expose in client bundles)
GLOSSYLOOKS_INTEGRATION_KEY="your-glossylooks-backend-secret-key"
MOZZ_INTEGRATION_KEY="your-mozz-backend-secret-key"
SMAV_GATEWAY_SECRET="your-smav-gateway-secret"
# Optional central service-role key for server-side audit/outbox persistence (NEVER expose in client bundles)
SMAV_SERVICE_ROLE_KEY=""

# Optional Multi-Outlet Bidirectional Sync Targets (Server-to-Server only)
# Supports dynamic future outlets via OUTLET_INTEGRATION_KEYS JSON or OUTLET_<CODE>_* env vars
OUTLET_INTEGRATION_KEYS="{}"
GLOSSYLOOKS_SYNC_WEBHOOK_URL=""
GLOSSYLOOKS_BILL_SYNC_WEBHOOK_URL="https://www.glossylooks.in/api/integrations/smav/sale-event"
GLOSSYLOOKS_SUPABASE_URL=""
GLOSSYLOOKS_SERVICE_ROLE_KEY=""
MOZZ_SYNC_WEBHOOK_URL=""
MOZZ_SUPABASE_URL=""
MOZZ_SERVICE_ROLE_KEY=""

# Central Billing Stage 2 & 3 Notification Dispatcher (Server-to-Server only)
# HMAC-SHA256 secret shared with outlet receivers (MUST be >= 32 characters)
SMAV_DISPATCH_SECRET=""
# Bearer secret authorizing POST /api/internal/notifications/dispatch (MUST be >= 32 characters)
SMAV_DISPATCH_CRON_SECRET=""
# Set to "false" to disable the in-process interval dispatcher when using external Cloud Scheduler
SMAV_ENABLE_INTERNAL_DISPATCHER="true"

# Externally managed outlet directories (comma-separated "outletCode:Display Owner Name")
# Outlets listed here are read-only for outlet admins in SMAV (SUPERADMIN emergency overrides audited)
SMAV_EXTERNALLY_MANAGED_OUTLETS="glossylooks:Glossy Looks"


